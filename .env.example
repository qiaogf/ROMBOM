# ============================================
# Cross-Border Store - Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# ---------- Required ----------
# Neon / PostgreSQL Database URL (with SSL for production)
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Get this from Neon dashboard: https://console.neon.tech/
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Public site URL (auto-set by Vercel, set manually for local dev)
# Production: https://your-store.vercel.app
# Preview: https://your-store-branch.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Vercel Auto-Set ----------
# NODE_ENV is automatically set to "production" by Vercel
# VERCEL_URL is automatically set to the deployment URL
# VERCEL_ENV is automatically set to "production" or "preview"

# ---------- Optional ----------
# Prisma query logging (info, warn, error)
# PRISMA_LOG_LEVEL="warn"

# Session security (auto-generated, change on security incident)
# SESSION_SECRET="your-32-char-random-secret"

# Rate limiting (optional override)
# RATE_LIMIT_MAX_REQUESTS="10"
# RATE_LIMIT_WINDOW_MS="60000"

# ---------- Email Us (SMTP) ----------
# Email Us 弹窗的留言通过 nodemailer + SMTP 转发到客服收件邮箱
# SMTP 服务器地址（如 smtp.gmail.com / smtp.office365.com / smtp.qq.com）
SMTP_HOST="smtp.gmail.com"
# SMTP 端口：465（SSL 直连，secure:true）/ 587（STARTTLS，secure:false）/ 25
SMTP_PORT="465"
# SMTP 登录账号（也是默认发件人，除非用 INQUIRY_FROM_EMAIL 覆盖）
SMTP_USER="your-account@gmail.com"
# SMTP 密码：Gmail 必须用「应用专用密码」而非登录密码；QQ/163 等用授权码
SMTP_PASS="your-app-password"
# 客服收件邮箱（留言最终送达地址）
INQUIRY_TO_EMAIL="support@your-store.com"
# 可选：自定义发件人地址（不填则使用 SMTP_USER）
# INQUIRY_FROM_EMAIL="no-reply@your-store.com"